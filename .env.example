# Copy to .env in repository root. All settings stay server-side.
MODEL_PROVIDER=none
OLLAMA_URL=http://127.0.0.1:11434
GEMMA_MODEL=gemma3:4b
# Optional hosted OpenAI-compatible Gemma endpoint, only after verifying free quota:
GEMMA_BASE_URL=
GEMMA_API_KEY=
HOSTED_GEMMA_FREE_CONFIRMED=false
# Optional ORS free account key. Empty uses public FOSSGIS foot service.
ORS_API_KEY=
OVERPASS_URL=https://overpass-api.de/api/interpreter
# One alternative attempt after transient failures; empty disables failover.
OVERPASS_FALLBACK_URL=https://overpass.private.coffee/api/interpreter
# Per-attempt wall-clock deadline, clamped to 2-30 seconds.
OVERPASS_TIMEOUT_SECONDS=15
USER_AGENT=Runningo/0.1 (small Hacktoberfest demo)
